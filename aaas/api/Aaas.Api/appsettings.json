{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Aaas": "Server=(localdb)\\MSSQLLocalDB;Database=Aaas;Trusted_Connection=True;TrustServerCertificate=True"
  },
  // Jwt:Key (32 octets minimum) uniquement en user-secrets, jamais ici.
  "Jwt": {
    "Issuer": "Aaas",
    "Audience": "Aaas",
    "ExpiresMinutes": 60
  },
  // Admin:Password (8 caractères minimum) uniquement en user-secrets, jamais ici.
  "Admin": {
    // PLACEHOLDER : email du compte admin de l'association, à fournir par l'association.
    "Email": "admin@aaas-placeholder.fr",
    // PLACEHOLDER : boîte qui reçoit les notifications (réservations, contact), à fournir par l'association.
    "NotificationEmail": "notifications@aaas-placeholder.fr"
  },
  // Smtp (Gmail) ou Journal (l'email est écrit dans le log). Smtp sans Smtp:Password => Journal + avertissement.
  "Email": {
    "Mode": "Smtp"
  },
  // Smtp:Password (mot de passe d'application Gmail) uniquement en user-secrets, jamais ici.
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    // PLACEHOLDER : compte Gmail expéditeur (validation en 2 étapes activée), à fournir par l'association.
    "User": "aaas-placeholder@gmail.com",
    "TimeoutSecondes": 10
  },
  "Site": {
    // PLACEHOLDER : numéro de l'association (E.164), à fournir par l'association.
    "Telephone": "+21672000000",
    // PLACEHOLDER : adresse de la page Facebook, à fournir par l'association.
    "Facebook": "https://www.facebook.com/aaas-placeholder",
    // PLACEHOLDER : adresse du compte Instagram, à fournir par l'association.
    "Instagram": "https://www.instagram.com/aaas-placeholder"
  }
}
